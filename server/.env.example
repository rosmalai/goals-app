# Required in production (Vercel, Render, etc.)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/goals?retryWrites=true&w=majority

# Local only — in-memory DB; do NOT set on production hosts
# USE_MEMORY_DB=true

# Optional: comma-separated frontend URLs for CORS (e.g. https://your-app.onrender.com)
# CLIENT_URL=
